{
  "name": "opencode-session-ref",
  "version": "0.2.0",
  "packageManager": "pnpm@11.0.0",
  "description": "OpenCode plugin to reference and inspect past sessions via TUI picker and agent tools.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "^2.0.15",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": "^1.9.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
